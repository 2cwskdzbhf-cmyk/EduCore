{
  "name": "Trigger Knowledge Gap Analysis on Quiz Completion",
  "description": "Automatically runs AI gap analysis when a student completes a quiz attempt",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "QuizAttempt"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "trigger_knowledge_gap_analysis_on_quiz_completion",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "analyzeQuizGapsAndGenerateReport",
            "args": {
              "quiz_attempt_id": "{id}"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "analyzeQuizGapsAndGenerateReport"
  }
}