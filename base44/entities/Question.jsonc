{
  "name": "Question",
  "type": "object",
  "properties": {
    "subject_id": {
      "type": "string",
      "description": "Reference to Subject"
    },
    "topic_id": {
      "type": "string",
      "description": "Reference to Topic"
    },
    "subtopic_id": {
      "type": "string",
      "description": "Reference to Subtopic"
    },
    "year_group": {
      "type": "number",
      "description": "Year group (7-11)",
      "minimum": 7,
      "maximum": 11
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ],
      "description": "Question difficulty level"
    },
    "question_type": {
      "type": "string",
      "enum": [
        "multiple_choice",
        "true_false",
        "short_answer",
        "written_answer"
      ],
      "description": "Type of question"
    },
    "question_text": {
      "type": "string",
      "description": "The question prompt"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Answer options - only for multiple_choice"
    },
    "correct_answer": {
      "type": "string",
      "description": "The correct answer or correct option text"
    },
    "correct_index": {
      "type": "number",
      "description": "Index of correct answer for multiple choice"
    },
    "explanation": {
      "type": "string",
      "description": "Optional explanation or mark scheme"
    },
    "marks": {
      "type": "number",
      "default": 1,
      "description": "Points/marks for this question"
    },
    "created_by": {
      "type": "string",
      "description": "Email of teacher who created this"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether question is available for use"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional tags for filtering"
    }
  },
  "required": [
    "subtopic_id",
    "year_group",
    "difficulty",
    "question_type",
    "question_text",
    "correct_answer"
  ]
}