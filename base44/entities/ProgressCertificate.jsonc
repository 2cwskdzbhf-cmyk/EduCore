{
  "name": "ProgressCertificate",
  "type": "object",
  "properties": {
    "student_email": {
      "type": "string",
      "description": "Student who earned the certificate"
    },
    "certificate_type": {
      "type": "string",
      "enum": [
        "module_completion",
        "topic_mastery",
        "accuracy_milestone",
        "streak_milestone",
        "overall_progress"
      ],
      "description": "Type of certificate"
    },
    "title": {
      "type": "string",
      "description": "Certificate title"
    },
    "description": {
      "type": "string",
      "description": "What was achieved"
    },
    "subject_id": {
      "type": "string",
      "description": "Related subject if applicable"
    },
    "topic_id": {
      "type": "string",
      "description": "Related topic if applicable"
    },
    "milestone_value": {
      "type": "number",
      "description": "The milestone achieved (e.g., 90 for 90% mastery)"
    },
    "issued_date": {
      "type": "string",
      "format": "date"
    },
    "certificate_data": {
      "type": "object",
      "description": "JSON data for certificate generation"
    }
  },
  "required": [
    "student_email",
    "certificate_type",
    "title",
    "description"
  ]
}