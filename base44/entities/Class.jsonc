{
  "name": "Class",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Class name (e.g., Year 9 Maths Set 1)"
    },
    "teacher_email": {
      "type": "string"
    },
    "co_teacher_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional teachers"
    },
    "assistant_teacher_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Assistant teachers"
    },
    "subject_id": {
      "type": "string"
    },
    "year_group": {
      "type": "number",
      "description": "Year group (7-11)",
      "minimum": 7,
      "maximum": 11
    },
    "academic_year": {
      "type": "string",
      "description": "e.g., 2024-2025"
    },
    "student_emails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "join_code": {
      "type": "string",
      "description": "Code for students to join"
    },
    "description": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "schedule": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "day": {
            "type": "string"
          },
          "start_time": {
            "type": "string"
          },
          "end_time": {
            "type": "string"
          },
          "room": {
            "type": "string"
          }
        }
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_archived": {
      "type": "boolean",
      "default": false
    },
    "battle_mode_enabled": {
      "type": "boolean",
      "default": true
    },
    "require_join_approval": {
      "type": "boolean",
      "default": false,
      "description": "If true, students must be approved before joining"
    },
    "theme_color": {
      "type": "string",
      "description": "Hex color for class theme, e.g. #7c3aed"
    },
    "theme_preset": {
      "type": "string",
      "enum": [
        "purple",
        "blue",
        "emerald",
        "amber",
        "rose",
        "cyan",
        "default"
      ],
      "default": "default"
    },
    "banner_url": {
      "type": "string",
      "description": "URL for class banner image"
    },
    "icon_emoji": {
      "type": "string",
      "description": "Emoji icon for the class, e.g. \ud83d\udcd0"
    },
    "pinned_item_id": {
      "type": "string",
      "description": "ID of pinned lesson or announcement"
    },
    "pinned_item_type": {
      "type": "string",
      "enum": [
        "lesson",
        "announcement"
      ],
      "description": "Type of pinned item"
    },
    "pinned_item_label": {
      "type": "string",
      "description": "Cached label of pinned item"
    }
  },
  "required": [
    "name",
    "teacher_email",
    "year_group"
  ]
}