{
  "name": "Topic",
  "type": "object",
  "properties": {
    "subject_id": {
      "type": "string",
      "description": "Reference to Subject"
    },
    "name": {
      "type": "string",
      "description": "Topic name (e.g., Fractions, Algebra)"
    },
    "description": {
      "type": "string",
      "description": "Optional description"
    },
    "order": {
      "type": "number",
      "description": "Display order within subject"
    }
  },
  "required": [
    "subject_id",
    "name"
  ]
}