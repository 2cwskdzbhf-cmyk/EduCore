{
  "name": "GlobalQuestion",
  "type": "object",
  "properties": {
    "subject_id": {
      "type": "string",
      "description": "Reference to Subject"
    },
    "subject_name": {
      "type": "string",
      "description": "Subject name (e.g., Maths, Science)"
    },
    "global_topic_id": {
      "type": "string",
      "description": "Reference to GlobalTopic (leaf/subtopic level)"
    },
    "topic_name": {
      "type": "string",
      "description": "Deprecated - use global_topic_id instead"
    },
    "year_group": {
      "type": "number",
      "description": "Year group (7-11)",
      "minimum": 7,
      "maximum": 11
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ],
      "description": "Question difficulty level"
    },
    "question_type": {
      "type": "string",
      "enum": [
        "mcq",
        "numeric",
        "short"
      ],
      "description": "Type of question"
    },
    "question_text": {
      "type": "string",
      "description": "The question prompt"
    },
    "choices": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Answer choices for MCQ"
    },
    "correct_answer": {
      "type": "string",
      "description": "The correct answer"
    },
    "correct_index": {
      "type": "number",
      "description": "Index of correct answer for MCQ"
    },
    "explanation": {
      "type": "string",
      "description": "Optional explanation or working"
    },
    "seed_key": {
      "type": "string",
      "description": "Unique key for deduplication (e.g., y7-fractions-easy-01)"
    }
  },
  "required": [
    "year_group",
    "difficulty",
    "question_type",
    "question_text",
    "correct_answer"
  ]
}